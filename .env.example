# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo ".env" NUNCA deve ser enviado ao GitHub.

# Supabase: Project URL e chave "secret" (Project Settings > API Keys)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sb_secret_sua_chave_aqui

# Redis Cloud: dados de conexão do banco (host, porta e senha do usuário "default")
REDIS_HOST=seu-endpoint.redis-cloud.com
REDIS_PORT=12345
REDIS_PASSWORD=sua_senha_aqui
